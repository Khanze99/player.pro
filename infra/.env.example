# Окружение тестового стенда (infra/docker-compose.stand.yml).
# Скопировать в infra/.env и заменить секреты:  make stand-env  — сгенерирует за вас.
# Файл infra/.env в git не коммитится.

# --- обязательное ---
POSTGRES_PASSWORD=playerpro
SECRET_KEY=change-me-openssl-rand-hex-32

# --- необязательное (значения ниже — дефолты) ---
POSTGRES_DB=playerpro
POSTGRES_USER=playerpro

# Порт, на котором API виден на хосте
API_PORT=8000

# ВНИМАНИЕ: при DEBUG=true POST /auth/otp/request возвращает OTP-код прямо в ответе.
# На закрытом тестовом стенде это единственный способ войти — SMS/email-шлюза пока нет.
# Для прода — false (см. чек-лист в docs/deploy.md).
DEBUG=true

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=90
NIGHTLY_RECALC_ENABLED=true
NIGHTLY_RECALC_HOUR_UTC=2

FEATURE_NUTRITION_ENABLED=false
FEATURE_CYCLE_ENABLED=false

# Канал доставки OTP отдельно для почты и телефона: log | email | sms.
# log — код только в логах контейнера (и в ответе при DEBUG=true).
# email — отправка по SMTP, нужны SMTP_* ниже.
# sms — провайдер пока не подключён, канал вернёт 503.
OTP_EMAIL_CHANNEL=log
OTP_PHONE_CHANNEL=log

# Нужны только при OTP_EMAIL_CHANNEL=email.
# Yandex Cloud Postbox: SMTP_USER — ID API-ключа сервисного аккаунта, SMTP_PASSWORD — его
# секрет как есть. Именно API-ключ (yc iam api-key create), а не статический ключ доступа:
# со статическим ключом сервер отвечает 535. Домен отправителя должен быть подтверждён.
SMTP_HOST=postbox.cloud.yandex.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PlayerPro <noreply@player-pro.ru>

# JSON-массив. Добавить адрес стенда, если мобильный клиент ходит с web-версии Expo.
CORS_ORIGINS=["http://localhost:8081"]
