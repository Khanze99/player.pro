DATABASE_URL=postgresql+asyncpg://playerpro:playerpro@localhost:5433/playerpro
REDIS_URL=redis://localhost:6379/0
OTP_STORE=redis
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=true
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=90
NIGHTLY_RECALC_ENABLED=true
NIGHTLY_RECALC_HOUR_UTC=2

# Аватары профиля. MEDIA_DIR в проде обязан быть на примонтированном volume —
# иначе загруженные фото не переживут релиз.
MEDIA_DIR=media
AVATAR_MAX_UPLOAD_BYTES=5242880
AVATAR_SIZE_PX=512

# Фича-флаги: код готов и покрыт тестами, но в интерфейс не выпущен.
# Клиент читает их из GET /api/v1/features — включается без релиза в сторы.
FEATURE_NUTRITION_ENABLED=false
FEATURE_CYCLE_ENABLED=false
